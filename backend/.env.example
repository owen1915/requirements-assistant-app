# Copy this file to .env and fill in your values.
# The app does NOT require these — users enter their API key in the browser.
# These are optional server-side defaults only.

# AI Provider — set to: anthropic | openai | local | ollama
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-YOUR-KEY-HERE
OPENAI_API_KEY=sk-YOUR-KEY-HERE

# ── Locally hosted / self-hosted LLM (AI_PROVIDER=local) ─────────────────────
# Any server that speaks the OpenAI chat-completions protocol. Setting
# LOCAL_LLM_URL is what makes this provider appear in the UI; the key is only
# needed by servers that check one.
#
#   VT ARC hosted API   https://llm-api.arc.vt.edu/api/v1   (key from llm.arc.vt.edu)
#   Ollama              http://localhost:11434/v1           (no key)
#   vLLM / llama.cpp    http://localhost:8000/v1            (no key)
#
LOCAL_LLM_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=gpt-oss-120b
# Reasoning models spend this budget thinking before answering, so 1200 is
# not enough — gpt-oss-120b returns nothing at all below roughly 2000.
LOCAL_LLM_MAX_TOKENS=4000
# Set to 0 for servers that reject the OpenAI response_format parameter.
LOCAL_LLM_JSON_MODE=1

# Ollama's own API (AI_PROVIDER=ollama). Kept for backwards compatibility —
# prefer AI_PROVIDER=local with LOCAL_LLM_URL=http://localhost:11434/v1.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
