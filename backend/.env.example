# Copy this file to .env and fill in your values.
#
# Analysis runs on ONE key held by the operator — the reviewers never enter a
# key and never see one. On Render these are set in the dashboard (Environment
# tab), not in this file.
#
# Because the deployment spends your credits, ACCESS_CODE is what stops anyone
# who finds the URL from spending them. Set it in production.

# AI Provider — set to: anthropic | openai | ollama
AI_PROVIDER=anthropic

# The key for whichever provider AI_PROVIDER names. Only that one is required;
# a key for the other provider simply makes it selectable in the UI.
ANTHROPIC_API_KEY=sk-ant-YOUR-KEY-HERE
OPENAI_API_KEY=sk-YOUR-KEY-HERE

# Shared code handed to the people you want using the app, including invited
# reviewers. Leave it unset locally; without it the API is open to anyone who
# reaches the URL, and the server logs a warning at startup saying so.
ACCESS_CODE=

# Ollama settings (only used when AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
